{
  "name": "mcp-video-editor",
  "version": "1.2.0",
  "description": "MCP server for editing videos in CapCut and OpenCut from Cursor, Codex, Claude, Antigravity, OpenCode, KiloCode, Qwen Code and ZCode",
  "license": "MIT",
  "type": "module",
  "bin": {
    "mcp-video-editor": "dist/index.js"
  },
  "files": [
    "dist",
    "README.md",
    "configs"
  ],
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "tsx src/index.ts",
    "inspect": "mcp-inspector node dist/index.js",
    "typecheck": "tsc --noEmit",
    "smoke": "npm run build && node scripts/smoke.mjs",
    "verify": "npm run typecheck && npm run smoke"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.4",
    "zod": "^3.23.8",
    "nanoid": "^5.0.4",
    "fast-xml-parser": "^4.3.6"
  },
  "devDependencies": {
    "typescript": "^5.4.5",
    "@types/node": "^20.12.7",
    "tsx": "^4.7.0"
  }
}
